{
  "manifest_version": 3,
  "name": "Thread — Captain Thread & Meet copilot",
  "short_name": "Thread",
  "version": "0.2.0",
  "description": "Captain Thread solves your doubts on any site — select text or draw around anything. Plus live Gnani transcripts, notes and the Thread agent inside Google Meet.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Thread",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "captain/captain-art.js",
        "captain/captain.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "sidePanel",
    "tabCapture",
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:3000/*",
    "https://thread-web.vercel.app/*",
    "https://ishaandev.co.in/*",
    "https://*.ishaandev.co.in/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://thread-web.vercel.app/*",
      "https://ishaandev.co.in/*",
      "https://*.ishaandev.co.in/*"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open Thread on this tab"
    },
    "captain-area": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Captain Thread: draw around something to ask about it"
    }
  }
}
